generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(PATIENT)
  createdAt    DateTime @default(now())
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}
